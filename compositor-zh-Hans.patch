diff --git a/Compositor/Localization.swift b/Compositor/Localization.swift
new file mode 100644
index 0000000..fa956e6
--- /dev/null
+++ b/Compositor/Localization.swift
@@ -0,0 +1,52 @@
+import Foundation
+
+/// The language is fixed for one launch so existing AppKit panels and document history stay consistent.
+enum L10n {
+    nonisolated static let preferenceKey = "compositor.interfaceLanguage"
+    nonisolated static let language: String = {
+        let choice = UserDefaults.standard.string(forKey: preferenceKey) ?? "system"
+        if choice == "en" || choice == "zh-Hans" { return choice }
+        let global = UserDefaults.standard.persistentDomain(forName: UserDefaults.globalDomain)
+        let preferred = global?["AppleLanguages"] as? [String] ?? Locale.preferredLanguages
+        let first = preferred.first ?? "en"
+        return first.hasPrefix("zh") && !first.hasPrefix("zh-Hant") && !first.hasPrefix("zh-TW") && !first.hasPrefix("zh-HK") ? "zh-Hans" : "en"
+    }()
+    private nonisolated static let resourceBundle: Bundle = {
+        guard let path = Bundle.main.path(forResource: language, ofType: "lproj"),
+              let bundle = Bundle(path: path) else { return .main }
+        return bundle
+    }()
+    nonisolated static func tr(_ key: String) -> String {
+        let translated = resourceBundle.localizedString(forKey: key, value: key, table: "Localizable")
+        if language == "zh-Hans", translated == key {
+            let capitalized = key.capitalized
+            let fallback = resourceBundle.localizedString(forKey: capitalized, value: capitalized, table: "Localizable")
+            if fallback != capitalized { return fallback }
+        }
+        return translated
+    }
+    /// All interpolated values are strings, with positional placeholders allowing translator reordering.
+    /// Replace in one pass: filenames containing `%2$@` must never become another argument.
+    nonisolated static func format(_ key: String, _ arguments: String...) -> String {
+        let template = tr(key)
+        guard let pattern = try? NSRegularExpression(pattern: "%([1-9][0-9]*)\\$@") else { return template }
+        let source = template as NSString
+        var result = template
+        for match in pattern.matches(in: template, range: NSRange(location: 0, length: source.length)).reversed() {
+            guard let index = Int(source.substring(with: match.range(at: 1))), arguments.indices.contains(index - 1),
+                  let range = Range(match.range, in: result) else { continue }
+            result.replaceSubrange(range, with: arguments[index - 1])
+        }
+        return result
+    }
+    /// App-owned AppleLanguages makes native menus, file panels and framework alerts follow the same choice.
+    nonisolated static func prepareNativeLanguage() {
+        UserDefaults.standard.set([language], forKey: "AppleLanguages")
+    }
+    nonisolated static func choose(_ value: String) {
+        guard ["system", "en", "zh-Hans"].contains(value) else { return }
+        UserDefaults.standard.set(value, forKey: preferenceKey)
+        if value == "system" { UserDefaults.standard.removeObject(forKey: "AppleLanguages") }
+        else { UserDefaults.standard.set([value], forKey: "AppleLanguages") }
+    }
+}
