+import Foundation
+let expected = CommandLine.arguments.last!
+precondition(L10n.language == expected, "Wrong language: \(L10n.language)")
+precondition(L10n.tr("Save") == (expected == "zh-Hans" ? "保存" : "Save"))
+precondition(L10n.tr("Gaussian Blur") == (expected == "zh-Hans" ? "高斯模糊" : "Gaussian Blur"))
+precondition(L10n.tr("Uncatalogued value") == "Uncatalogued value")
+let value = "项目%2$@😀.comp"
+let message = L10n.format("Save changes to %1$@?", value)
+precondition(message.contains(value), "User filenames must be unchanged")
+let conflict = L10n.format("%1$@ is assigned to both %2$@ and %3$@.", "⌘X", "A%3$@", "B")
+precondition(conflict.contains("A%3$@"), "Arguments must not be interpolated twice")
+precondition(L10n.format("Current: %1$@ × %2$@ pixels", "120", "80") == (expected == "zh-Hans" ? "当前：120 × 80 像素" : "Current: 120 × 80 pixels"))
+precondition(L10n.tr("Language") == (expected == "zh-Hans" ? "语言" : "Language"))
+print("PASS: \(expected) resources, fallback, dynamic messages, Unicode and literal placeholder preservation")
