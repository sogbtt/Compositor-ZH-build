+import XCTest
+@testable import Compositor
+
+final class LocalizationTests: XCTestCase {
+    func testTranslatedFormatPreservesUserContentAndPlaceholderText() {
+        let filename = "图层%2$@😀.comp"
+        XCTAssertTrue(L10n.format("Save changes to %1$@?", filename).contains(filename))
+        let message = L10n.format("%1$@ is assigned to both %2$@ and %3$@.", "⌘X", "A%3$@", "B")
+        XCTAssertTrue(message.contains("A%3$@"))
+    }
+    func testUnknownKeyFallsBackUnchanged() {
+        XCTAssertEqual(L10n.tr("unknown.localization.key"), "unknown.localization.key")
+    }
+    @MainActor func testShortcutAndBlendIdentitiesDoNotDependOnLanguage() throws {
+        let undo = try XCTUnwrap(ShortcutDefinition.all.first { $0.id == "Menus:Undo" })
+        XCTAssertEqual(undo.title, "Undo")
+        XCTAssertEqual(undo.original, ShortcutChord("z", 1))
+        XCTAssertEqual(String(data: try JSONEncoder().encode(LayerBlendMode.multiply), encoding: .utf8), "\"Multiply\"")
+        XCTAssertEqual(LayerBlendMode(rawValue: "Multiply"), .multiply)
+        XCTAssertNil(LayerBlendMode(rawValue: "正片叠底"))
+    }
+}
