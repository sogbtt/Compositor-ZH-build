new file mode 100644
index 0000000..7cd7160
--- /dev/null
+++ b/Compositor/UI/LanguageSettings.swift
@@ -0,0 +1,30 @@
+import SwiftUI
+
+@MainActor
+final class LanguageSettings {
+    static let shared = LanguageSettings()
+    private let panel = FloatingPanelController(name: "languageSettings")
+    func show() { panel.show(title: L10n.tr("Language"), content: LanguageSettingsView(close: { self.panel.close() })) }
+}
+
+private struct LanguageSettingsView: View {
+    let close: () -> Void
+    @State private var selection = UserDefaults.standard.string(forKey: L10n.preferenceKey) ?? "system"
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            Text(L10n.tr("Interface Language")).font(.title2.bold())
+            Picker(L10n.tr("Language"), selection: $selection) {
+                Text(L10n.tr("Follow System")).tag("system")
+                Text("简体中文").tag("zh-Hans")
+                Text("English").tag("en")
+            }
+            Text(L10n.tr("Save your projects, then quit and reopen Compositor to apply the language to all windows and menus."))
+                .foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true)
+            HStack {
+                Spacer()
+                Button(L10n.tr("Cancel"), action: close).keyboardShortcut(.cancelAction)
+                Button(L10n.tr("Save")) { L10n.choose(selection); close() }.keyboardShortcut(.defaultAction)
+            }
+        }.padding(24).frame(width: 420).roundedControls()
+    }
+}
