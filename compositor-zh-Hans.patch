+#!/usr/bin/env python3
+"""Verify resource parity and literal localization references; does not build the app."""
+import collections,json,pathlib,re,sys
+root=pathlib.Path(sys.argv[1])
+def load(language):
+    result={}
+    for line in (root/'Compositor'/f'{language}.lproj'/'Localizable.strings').read_text().splitlines():
+        if not line or line.startswith('//'):continue
+        match=re.fullmatch(r'("(?:\\.|[^"\\])*") = ("(?:\\.|[^"\\])*");',line)
+        assert match, 'Bad resource syntax: '+line
+        key,value=map(json.loads,match.groups())
+        assert key not in result, 'Duplicate key: '+key
+        result[key]=value
+    return result
+en,zh=load('en'),load('zh-Hans')
+assert en.keys()==zh.keys(), 'Language keys differ'
+for key in en:
+    assert zh[key], 'Empty translation: '+key
+    assert en[key]==key, 'English fallback changed: '+key
+    assert collections.Counter(re.findall(r'%\d+\$@',key))==collections.Counter(re.findall(r'%\d+\$@',zh[key])), 'Placeholder mismatch: '+key
+references=0
+for path in (root/'Compositor').rglob('*.swift'):
+    for match in re.finditer(r'L10n\.(?:tr|format)\(("(?:\\.|[^"\\])*")',path.read_text()):
+        literal=match.group(1)
+        if '\\(' in literal:continue  # Four runtime shortcut templates are covered by smoke checks.
+        try:key=json.loads(literal)
+        except json.JSONDecodeError:continue
+        assert key in en, f'Missing resource {key!r}: {path}'
+        references+=1
+# Import protocol fields must never be translated.
+for name in ['PSDText.swift','PSDVector.swift']:
+    source=(root/'Compositor/IO/PSD'/name).read_text()
+    assert not re.search(r'(?:walk|side|key:)\([^\n]*L10n\.tr|key:\s*L10n',source), 'PSD keys localized: '+name
+source=(root/'Compositor/UI/BlendModePicker.swift').read_text()
+assert 'item.representedObject = mode.rawValue' in source
+assert 'LayerBlendMode(rawValue: $0.title)' not in source
+print(f'PASS: {len(en)} bilingual keys, unique/nonempty values, unchanged English and matching placeholders; {references} literal source references; PSD and blend identity guards')
