+#!/bin/bash
+# Run from any directory; requires macOS Command Line Tools (or full Xcode).
+set -euo pipefail
+localization_root="$(cd "$(dirname "$0")/.." && pwd)"
+localization_tmp="$(mktemp -d "${TMPDIR:-/tmp}/compositor-localization.XXXXXX")"
+trap 'rm -rf "$localization_tmp"' EXIT
+python3 "$localization_root/scripts/localization/audit.py" "$localization_root"
+plutil -lint "$localization_root/Compositor/en.lproj/Localizable.strings" "$localization_root/Compositor/zh-Hans.lproj/Localizable.strings" "$localization_root/Config/Info.plist"
+mkdir -p "$localization_tmp/Checks.app/Contents/MacOS" "$localization_tmp/Checks.app/Contents/Resources"
+cp -R "$localization_root/Compositor/en.lproj" "$localization_root/Compositor/zh-Hans.lproj" "$localization_tmp/Checks.app/Contents/Resources/"
+cat > "$localization_tmp/Checks.app/Contents/Info.plist" <<'EOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<plist version="1.0"><dict><key>CFBundleIdentifier</key><string>local.compositor.localization.checks</string><key>CFBundleExecutable</key><string>checks</string><key>CFBundleDevelopmentRegion</key><string>en</string></dict></plist>
+EOF
+swiftc -module-cache-path "$localization_tmp/module-cache" "$localization_root/Compositor/Localization.swift" "$localization_root/scripts/localization/main.swift" -o "$localization_tmp/Checks.app/Contents/MacOS/checks"
+"$localization_tmp/Checks.app/Contents/MacOS/checks" -compositor.interfaceLanguage zh-Hans zh-Hans
+"$localization_tmp/Checks.app/Contents/MacOS/checks" -compositor.interfaceLanguage en en
+python3 - "$localization_root" <<'PY'
+import pathlib,subprocess,sys
+files=sorted(str(p) for p in (pathlib.Path(sys.argv[1])/'Compositor').rglob('*.swift'))
+subprocess.run(['swiftc','-frontend','-parse',*files],check=True)
+print('PASS: all',len(files),'app Swift files parse (not a full app build)')
+PY
+python3 - "$localization_root" "$localization_tmp" <<'PY'
+import pathlib,sys
+root,scratch=map(pathlib.Path,sys.argv[1:])
+source=(root/'Compositor/UI/KeyboardShortcuts.swift').read_text()
+(scratch/'definitions.swift').write_text(source.split('@MainActor @Observable')[0])
+(scratch/'main.swift').write_text((root/'scripts/localization/shortcut-main.swift').read_text())
+PY
+swiftc -module-cache-path "$localization_tmp/module-cache" "$localization_root/Compositor/Localization.swift" "$localization_tmp/definitions.swift" "$localization_tmp/main.swift" -o "$localization_tmp/shortcut-identities"
+"$localization_tmp/shortcut-identities" -compositor.interfaceLanguage zh-Hans > "$localization_tmp/shortcuts.json"
+cmp "$localization_root/scripts/localization/upstream-shortcuts-1.5.2.json" "$localization_tmp/shortcuts.json"
+echo 'PASS: 119 shortcut IDs, keys and modifiers exactly match the upstream 1.5.2 fixture'
